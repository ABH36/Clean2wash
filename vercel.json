{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(assets|static|public|favicon.ico|manifest.json|vite.svg)/(.*)",
      "dest": "/Frontend/$1/$2",
      "check": true
    },
    {
      "src": "/(admin|spare-driver|captain|profile|bookings|vehicles|addresses|wallet|refer|help|rate|notifications|sos-active|safety|kyc-verification|compliance|payments|onboarding|login|signup|otp-verify|share-trip)(/.*)?",
      "dest": "/Frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/Frontend/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "/Frontend/index.html"
    }
  ]
}
