{
  "version": 2,
  "builds": [
    {
      "src": "Backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/Backend/server.js"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/Backend/server.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/Backend/server.js"
    },
    {
      "source": "/((?!api|socket.io|uploads).*)",
      "destination": "/Frontend/index.html"
    }
  ]
}
